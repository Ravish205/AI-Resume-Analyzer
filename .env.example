# AI Resume Analyzer Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional Semantic Similarity Embedding Model
# Defaults to local TF-IDF if sentence-transformers is not enabled
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional External API Keys (External AI APIs are optional, not mandatory)
# OPENAI_API_KEY=your_openai_api_key_here

